{
  "expo": {
    "name": "BioSecure Farm",
    "slug": "biosecure-farm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D6EFD"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.biosecurefarm.app" },
    "android": {
      "adaptiveIcon": { "foregroundImage": "./src/assets/adaptive-icon.png", "backgroundColor": "#0D6EFD" },
      "package": "com.biosecurefarm.app",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": { "favicon": "./src/assets/favicon.png", "bundler": "metro" },
    "plugins": ["expo-router", "expo-font", ["expo-notifications", { "icon": "./src/assets/notification-icon.png" }]],
    "extra": {
      "apiUrl": "http://localhost:5000/api",
      "googleMapsApiKey": "<YOUR_GOOGLE_MAPS_API_KEY>",
      "openWeatherApiKey": "3ce7a4e03e0e642f1467780e357d7da5"
    }
  }
}
