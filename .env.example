# Optional: set only if the API uses a host different from the app host.
# Leave unset for LAN access; the app uses the browser's hostname on port 5000.
# VITE_API_BASE_URL=http://localhost:5000/api
VITE_OPENWEATHER_API_KEY=your_openweather_api_key

# Nodemailer Real Email Delivery (Gmail)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
# 3. Add credentials below in your .env or .env.local file:
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password
